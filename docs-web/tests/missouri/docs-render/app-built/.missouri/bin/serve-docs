#!/bin/sh
# Serve docs-web dist/ as static files.
# $0 resolves to the original bin/ location (missouri uses absolute paths).
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
PROJECT=$(cd "$SCRIPT_DIR/../../../../../../.." && pwd)
DIST="$PROJECT/docs-web/dist"
if [ ! -d "$DIST" ]; then
    echo "dist not found at $DIST — run 'trunk build' in docs-web/ first" >&2
    exit 1
fi

# Write a small server that prints the port to stderr immediately.
SCRIPT="/tmp/serve-docs-$$.py"
cat > "$SCRIPT" << 'PYEOF'
import http.server
import os
import socketserver
import sys

directory = sys.argv[1]

class Handler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=directory, **kwargs)
    def log_message(self, format, *args):
        pass  # suppress request logging

with socketserver.TCPServer(("127.0.0.1", 0), Handler) as httpd:
    port = httpd.server_address[1]
    print(f"listening on port {port}", file=sys.stderr, flush=True)
    httpd.serve_forever()
PYEOF
exec uv run python3 "$SCRIPT" "$DIST"
