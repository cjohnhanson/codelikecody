#!/bin/sh
# Playwright browser test for docs-web
# Writes a temp script and runs it via uv to avoid heredoc env issues
SCRIPT="/tmp/browser-test-$$.py"
cat > "$SCRIPT" << 'PYTHON'
# /// script
# requires-python = ">=3.12"
# dependencies = ["playwright"]
# ///
import json
import os
import sys
import time

from playwright.sync_api import sync_playwright

action = sys.argv[1] if len(sys.argv) > 1 else "landing"
port = os.environ.get("PORT", "8080")
base_url = f"http://127.0.0.1:{port}"

print(f"browser-test: action={action} port={port} url={base_url}", file=sys.stderr)

with sync_playwright() as p:
    browser = p.chromium.launch()
    context = browser.new_context(viewport={"width": 1280, "height": 720})
    page = context.new_page()

    if action == "landing":
        page.goto(base_url, wait_until="networkidle")
        time.sleep(2)

        os.makedirs("browser", exist_ok=True)
        page.screenshot(path="browser/screenshot.png", full_page=True)

        # Check that the landing page rendered with doc content
        heading = page.query_selector("h1")
        heading_text = heading.inner_text() if heading else ""

        # Check navigation links exist
        nav_links = page.query_selector_all("nav a")
        link_texts = [a.inner_text() for a in nav_links]

        # Check that at least one doc section rendered
        sections = page.query_selector_all("h2, h3")
        section_texts = [s.inner_text() for s in sections]

        state = {
            "heading": heading_text,
            "nav_link_count": len(link_texts),
            "nav_links": link_texts,
            "section_count": len(section_texts),
            "sections": section_texts,
        }
        with open("browser/state.json", "w") as f:
            json.dump(state, f, indent=2)

        print(json.dumps(state))

    elif action == "doc-page":
        # Navigate to a specific doc page (getting-started)
        page.goto(f"{base_url}/getting-started", wait_until="networkidle")
        time.sleep(2)

        os.makedirs("browser", exist_ok=True)
        page.screenshot(path="browser/screenshot.png", full_page=True)

        heading = page.query_selector("h1")
        title = heading.inner_text() if heading else "not found"

        # Check that markdown rendered — look for code blocks and lists
        code_blocks = page.query_selector_all("pre code")
        lists = page.query_selector_all("ul, ol")

        state = {
            "title": title,
            "code_block_count": len(code_blocks),
            "list_count": len(lists),
            "has_content": len(page.inner_text("main")) > 100 if page.query_selector("main") else False,
        }
        with open("browser/state.json", "w") as f:
            json.dump(state, f, indent=2)

        print(json.dumps(state))

    browser.close()
PYTHON
exec uv run --with playwright python3 "$SCRIPT" "$@"
