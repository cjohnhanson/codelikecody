#!/bin/sh
cat > clc.yaml << 'YAML'
workspaces:
  docker-worker:
    type: worker
    agent: opus
    isolation: docker
    docker_image: clc-worker:latest
coordinators:
  dev:
    workspace: docker-worker
    max_workers: 1
    selector:
      label: backend
      project: v0.1.0
    reviewers:
      - scope-check
      - test-quality
supervisor:
  poll_interval: 5
YAML
cat > clc.yml << 'YAML'
main_branch: main
admin_branch: clc-admin
YAML
mkdir -p .clc/reviewers
cat > .clc/reviewers/scope-check.md << 'MD'
---
model: opus
max_turns: 3
---

Check that the diff matches the tisket scope.
MD
cat > .clc/reviewers/test-quality.md << 'MD'
---
model: opus
max_turns: 5
---

Check that tests are meaningful.
MD
